PORT=3000
NODE_ENV=development
JWT_SECRET=sua_chave_secreta
# Em produção, defina a origem autorizada do frontend.
FRONTEND_ORIGIN=http://localhost:3000
# Alternativa ao bloco DB_*:
# DATABASE_URL=postgresql://...

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_NAME=clothstock_db

# O cadastro público POST /api/auth/register é desligado quando
# NODE_ENV=production ou quando a variável VERCEL existe.
# Defina ALLOW_PUBLIC_REGISTRATION=true apenas se um ambiente
# específico realmente precisar reabrir o cadastro em produção.
# ALLOW_PUBLIC_REGISTRATION=false

# Senha da conta de demonstração VIEWER (avaliador@clothstock.com).
# Usada por "npm run viewer:create" e por "npm run verify:permissions".
# Não deixe a senha real neste arquivo: use-a só na sessão do shell.
# VIEWER_ACCOUNT_PASSWORD=
# VIEWER_ACCOUNT_EMAIL=avaliador@clothstock.com